# ================================================================
# WAmate - WhatsApp Self-Chat AI Second Brain Configuration
# ================================================================

# [REQUIRED] Google Gemini API Key (or multiple comma-separated keys for automatic 429 rotation)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional additional keys across projects for higher combined RPD/RPM throughput:
# GEMINI_API_KEYS=key_1,key_2,key_3

# Gemini Model name (default: gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Rolling multi-turn conversation memory in self-chat (default: 6 turns, 20 min TTL)
CONVERSATION_MEMORY_TURNS=6
CONVERSATION_MEMORY_TTL_MINUTES=20

# Command prefix to trigger Gemini in self-chat (default: !ask)
COMMAND_PREFIX=!ask

# [OPTIONAL] Pairing Code Authentication
# If set with country code (e.g., 14155552671 with no '+' or dashes),
# WhatsApp will generate an 8-character code (e.g. ABCD-1234)
# which you can type into WhatsApp > Linked Devices > Link with phone number.
# If left blank, a QR code will be displayed in the console for scanning.
PHONE_NUMBER=

# Data directory path (default: ./data)
DATA_DIR=./data

# Timezone (e.g. UTC, America/New_York, Europe/London, Asia/Kolkata)
TZ=UTC

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# [RECOMMENDED] Media Storage & Auto-Download (default: true)
# Uses ZERO Gemini API calls (0 tokens, 0 rate limit).
# Pre-downloads raw files (PDFs, Excel, Word, photos, voice notes, videos, stickers, status updates) to local disk while fresh.
# This ensures all media remains accessible forever, even after WhatsApp's 30-day CDN expiration.
# OCR is deferred and executed strictly on-demand when you ask a question.
ENABLE_MEDIA_STORAGE=true
MEDIA_STORAGE_LOOKBACK_DAYS=30
MEDIA_STORAGE_MAX_SIZE_MB=0
MEDIA_STORAGE_TYPES=all
MEDIA_STORAGE_INCLUDE_STATUSES=true
MEDIA_STORAGE_DELAY_SECONDS=1.5
# Optional retention limit in days for downloaded Status updates (0 = keep forever)
STATUS_MEDIA_RETENTION_DAYS=0

# [OPTIONAL] Local CPU Background Indexing (0 Gemini API calls)
# Note: On-Demand AI Vision, PDF, and Voice Note OCR via Gemini is ALWAYS enabled during '!ask' queries.
# - ENABLE_LOCAL_DOC_INDEX=true: pre-indexes text inside stored PDFs, Excel, Word, PowerPoint, CSV & TXT files.
# - ENABLE_LOCAL_OCR=true: pre-indexes text inside stored images via offline 'tesseract' CLI (sudo apt install -y tesseract-ocr).
ENABLE_LOCAL_DOC_INDEX=true
ENABLE_LOCAL_OCR=false

# [OPTIONAL] Real-time self-chat alert when someone deletes a message for everyone (default: false)
# Deleted & edited originals are ALWAYS silently archived in the Anti-Delete Vault (!deleted / !edits / !ask).
ANTI_DELETE_NOTIFY=false

# [RECOMMENDED] Lightweight Local Web Search & Media Browser UI (0 external dependencies, 0 API cost)
# Binds to 127.0.0.1 by default so it stays private behind localhost / SSH tunnel / Tailscale.
# Access from your laptop over SSH: ssh -N -L 8765:127.0.0.1:8765 root@YOUR_VPS_IP -> http://127.0.0.1:8765
ENABLE_WEB_UI=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8765
# Optional HTTP Basic Auth password (recommended if setting WEB_UI_HOST=0.0.0.0 or sharing access)
WEB_UI_PASSWORD=
